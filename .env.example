# QuantumShield Environment Configuration

# Optional: Path to a local repository for offline evaluation (e.g. /path/to/repo or C:\path\to\repo)
QUANTUMSHIELD_LOCAL_SCAN_ROOT=

# Enable outbound HTTPS remote repository acquisition (default: true)
REMOTE_SCAN_ENABLED=true

# Server port and host
PORT=8000
HOST=0.0.0.0
